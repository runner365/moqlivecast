# ---- server ----
STREAMVOX_HOST=0.0.0.0
STREAMVOX_PORT=8000
# ga   -> response.output_audio.delta / response.output_text.delta
# beta -> response.audio.delta / response.text.delta
STREAMVOX_EVENT_STYLE=ga

# ---- providers: mock | bailian | deepseek | qwen | openai ----
# mock 不需要任何 key，先把整条链路跑通；填好下面的 key 后改成 bailian / deepseek。
ASR_PROVIDER=mock
TTS_PROVIDER=mock
LLM_PROVIDER=mock

# ---- 阿里百炼（DashScope）----
DASHSCOPE_API_KEY=
# paraformer-realtime-v2 / fun-asr-realtime ...
ASR_MODEL=paraformer-realtime-v2
# true: 边录边喂 ASR，commit 后只取最终 text；false: commit 后整段批量识别
ASR_STREAMING=true
# 业务空间专属域名（可选）：
# wss://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
DASHSCOPE_WS_URL=

# CosyVoice：cosyvoice-v2 / cosyvoice-v3-plus ...
TTS_MODEL=cosyvoice-v2
# cosyvoice-v2 常用 longxiaochun_v2；v3 常用 longanyang，按控制台音色列表填
TTS_VOICE=longxiaochun_v2
# 8000 / 16000 / 22050 / 24000 / 44100 / 48000；默认 16k 省下行，Web 客户端会读 session 里的实际 rate
TTS_SAMPLE_RATE=16000
TTS_SPEECH_RATE=1.0

# ---- LLM（OpenAI 兼容接口）----
# DeepSeek: https://api.deepseek.com/v1  + deepseek-flash
# 百炼 Qwen: https://dashscope.aliyuncs.com/compatible-mode/v1 + qwen-plus
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
LLM_THINKING=false
LLM_API_KEY=
LLM_TEMPERATURE=0.7

# ---- agent ----
STREAMVOX_INSTRUCTIONS=You are StreamVox, a friendly voice assistant. Your reply is spoken aloud by TTS, so make it TTS-friendly: use plain conversational text only, with no Markdown (no bold markers, headings, bullet or numbered list markers, tables, code blocks, or links), no emoji, and no decorative symbols. If you enumerate, use natural spoken ordinals (first, second, ... / 第一、第二…) instead of list markers. Use short sentences, write numbers and abbreviations the way they should be read aloud, and keep answers short (2-4 sentences) unless the user asks for more detail.
STREAMVOX_HISTORY_TURNS=12

# ---- mock 模式 ----
MOCK_ASR_TEXT=你好，我想练习一下英语口语。
ASYNC_MOCK_DELAY_MS=150
